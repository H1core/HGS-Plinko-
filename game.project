[bootstrap]
main_collection = /app/boostrap/bootstrap.collectionc

[script]
shared_state = 1

[display]
width = 768
height = 1336
high_dpi = 1
update_frequency = 120

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = HGS-Plinko
version = 1.0.0
custom_resources = /app/resources
dependencies#0 = https://github.com/Insality/druid/archive/refs/tags/1.3.0.zip
dependencies#1 = https://github.com/britzl/monarch/archive/refs/tags/6.0.2.zip
dependencies#2 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip

[native_extension]
app_manifest = /manifest.appmanifest

[render]
clear_color_red = 0.443137
clear_color_green = 0.815686
clear_color_blue = 1.0

[sprite]
max_count = 8192

[collection]
max_instances = 8192

